#------------------------------------------------------------------------------
# AdaptiveCpp compiler (acpp) - a clang variant
# with C++ standard parallelism offload
#------------------------------------------------------------------------------
include $(GENERAL_RULES)/Clang/c++

CC         := acpp$(COMPILER_VERSION) -std=c++17

c++ARCH    := -m64 -pthread

c++DEVICE  := --acpp-stdpar --acpp-targets=generic \
    -DFOAM_OFFLOAD -DFOAM_OFFLOAD_ACPP \
    -D__host__= -D__device__=

ifneq (,$(strip $(WM_COMPILE_OPTION)))
    sinclude $(DEFAULT_RULES)/c++$(WM_COMPILE_OPTION)
endif

c++FLAGS    = \
    $(c++ARCH) $(GFLAGS) $(c++WARN) $(c++OPT) $(c++DBUG) $(ptFLAGS) \
    $(FOAM_EXTRA_CXXFLAGS) $(LIB_HEADER_DIRS) -fPIC

Ctoo        = $(WM_SCHEDULER) $(CC) $(c++FLAGS) -c $< -o $@
cctoo       = $(Ctoo)
cpptoo      = $(Ctoo)
cxxtoo      = $(Ctoo)

include $(GENERAL_RULES)/Acpp/link-c++

#------------------------------------------------------------------------------
