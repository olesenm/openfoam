# ----------------------------------------------------------------------------
# HDF5 include/library directories - synthesize from ARCH_PATH as required

ifeq (,$(strip $(HDF5_INC_DIR)))
ifneq (,$(strip $(HDF5_ARCH_PATH)))

  HDF5_INC_DIR = $(HDF5_ARCH_PATH)/include
  ifneq (,$(wildcard $(HDF5_ARCH_PATH)/lib$(WM_COMPILER_LIB_ARCH)))
  HDF5_LIB_DIR    := $(HDF5_ARCH_PATH)/lib$(WM_COMPILER_LIB_ARCH)
  else
  HDF5_LIB_DIR    := $(HDF5_ARCH_PATH)/lib
  endif

endif
endif

# ----------------------------------------------------------------------------

HDF5_INCLUDES  =
HDF5_LIBRARIES =

ifneq (,$(strip $(HDF5_INC_DIR)))
HDF5_INCLUDES  := $(foreach dir,$(HDF5_INC_DIR),-I$(dir))
endif

ifneq (,$(strip $(HDF5_LIB_DIR)))
HDF5_LIBRARIES := $(foreach dir,$(HDF5_LIB_DIR),-L$(dir)) -lhdf5
endif

