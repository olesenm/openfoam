FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs
(
    dynamicLoadBalancing
);

application     pimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         1.0;

deltaT          0.05;

writeControl    runTime;

writeInterval   0.05;

purgeWrite      0;

writeFormat     ascii;

writePrecision  16;

timeFormat      general;

timePrecision   8;

runTimeModifiable false;

functions
{
    readFields1
    {
        type            readFields;
        libs            (fieldFunctionObjects);
        fields          ( testField );
        readOnStart     true;
    }

    writeObjects1
    {
        type            writeObjects;
        libs            (utilityFunctionObjects);
        writeOption     anyWrite;
        field           testField;
    }

    #include "FOs/FOcontinuityError"
    #include "FOs/FOfieldStatistics"
    #include "FOs/FOsurfaceInterpolate"
}

