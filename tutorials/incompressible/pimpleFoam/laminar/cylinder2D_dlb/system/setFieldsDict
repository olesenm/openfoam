FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue testField 0
);

regions
(
    boxToCell
    {
        box (0.625 0.125 -0.125) (0.875 0.375 0.125);
        fieldValues
        (
            volScalarFieldValue testField 0.5
        );
    }
);

